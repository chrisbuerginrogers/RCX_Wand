// Configures sensor 0 as a light sensor, then loops reading it: beeps
// only while it's dark (raw value below 50).
//
// chk (opcode 0x85) reads backwards from a normal if-statement: it
// jumps PAST the label when the comparison is FALSE, so code between
// chk and its label only runs when the comparison is TRUE. Here the
// comparison is "sensor[0] < 50" (src 9 = SRC_SENSOR_VALUE, val 0 =
// sensor index; src 2 = SRC_CONSTANT, val 50 = threshold; relop 1 =
// less-than) -- true means dark, so a bright reading (false) jumps to
// "skip" and the beep is skipped.
task 0
sent 0,3                // sensor 0 = type 3 (Reflection/light)
loop:
chk 9,0,1,2,50,skip     // if NOT (sensor[0] < 50), skip the beep
plays 4
skip:
wait 2,20
jmp loop
endt
